# Copy to .env (Appendix C.1 / C.2). Docker Compose reads it for variable substitution and the
# backend containers load it as their environment. Every application setting uses the AQUAINTEL_ prefix.

# ---- secrets used by docker-compose.yml ----
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
POSTGRES_PASSWORD=aquaintel
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GRAFANA_ADMIN_PASSWORD=admin
# created in Admin > API keys: one with telemetry:ingest for MQTT, one with ml:read, ml:performance and ml:register for Airflow
INTEGRATION_API_KEY=
AIRFLOW_API_KEY=

# ---- application ----
AQUAINTEL_DEBUG=false
AQUAINTEL_LOG_LEVEL=INFO
# plant time zone (IANA name): tariff windows, shift reports and demand patterns follow this clock
AQUAINTEL_TZ=Asia/Kolkata
AQUAINTEL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AQUAINTEL_RATE_LIMIT_ENABLED=true
AQUAINTEL_JWT_EXPIRY_MINUTES=60
AQUAINTEL_JWT_REFRESH_DAYS=7

# ---- local run without Docker (uvicorn on the host) ----
# AQUAINTEL_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars
# AQUAINTEL_DATABASE_URL=postgresql+asyncpg://aquaintel:aquaintel@localhost:5432/aquaintel
# AQUAINTEL_REDIS_URL=redis://localhost:6379/0
# AQUAINTEL_EVENT_BUS=auto      # kafka if reachable, else an in-process bus
# AQUAINTEL_TASK_MODE=inline    # asyncio scheduler instead of Celery workers

# ---- optional integrations ----
# AQUAINTEL_MLFLOW_TRACKING_URI=http://localhost:5000
# AQUAINTEL_SMTP_HOST=smtp.mailtrap.io
# AQUAINTEL_SMTP_PORT=2525
# AQUAINTEL_SMTP_USER=
# AQUAINTEL_SMTP_PASSWORD=
# AQUAINTEL_SMS_PROVIDER=log
# AQUAINTEL_SENTRY_DSN=
